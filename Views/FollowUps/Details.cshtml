@model ACXIOMCRM.Models.FollowUp
@{ ViewData["Title"] = "Follow-up Details"; var canEdit = await CrmPermissions.HasPermissionAsync(User, "FollowUps", "Edit"); var canDelete = await CrmPermissions.HasPermissionAsync(User, "FollowUps", "Delete"); }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 760px"><div class="card-header bg-info text-dark"><h4 class="mb-0">Follow-up Details</h4></div><div class="card-body">
<dl class="row"><dt class="col-sm-4">Lead</dt><dd class="col-sm-8">@Model.Lead?.Name@if (!string.IsNullOrWhiteSpace(Model.Lead?.Company)) { <span>(@Model.Lead.Company)</span> }</dd><dt class="col-sm-4">Subject</dt><dd class="col-sm-8">@Model.Subject</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd><dt class="col-sm-4">Scheduled</dt><dd class="col-sm-8">@Model.ScheduledDate.ToString("dd MMM yyyy, h:mm tt")</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Created</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, h:mm tt") UTC</dd></dl>
@if (canEdit) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a> }@if (canDelete) { <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a> } <a asp-action="Index" class="btn btn-secondary">Back</a>
</div></div></div>
