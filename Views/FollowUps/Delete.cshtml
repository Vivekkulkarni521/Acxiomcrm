@model ACXIOMCRM.Models.FollowUp
@{ ViewData["Title"] = "Delete Follow-up"; }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 700px"><div class="card-header bg-danger text-white"><h3 class="mb-0">Delete Follow-up</h3></div><div class="card-body"><h5>Are you sure you want to delete this follow-up?</h5><dl class="row mt-3"><dt class="col-sm-4">Lead</dt><dd class="col-sm-8">@Model.Lead?.Name</dd><dt class="col-sm-4">Subject</dt><dd class="col-sm-8">@Model.Subject</dd><dt class="col-sm-4">Scheduled</dt><dd class="col-sm-8">@Model.ScheduledDate.ToString("dd MMM yyyy, h:mm tt")</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd></dl><form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Confirm Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form></div></div></div>
