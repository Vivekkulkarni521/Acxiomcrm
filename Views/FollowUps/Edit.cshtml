@model ACXIOMCRM.Models.FollowUp
@using ACXIOMCRM.Models
@{ ViewData["Title"] = "Edit Follow-up"; }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 760px"><div class="card-header bg-warning"><h4 class="mb-0">Edit Follow-up</h4></div><div class="card-body">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select"><option value="">Select a lead</option></select><span asp-validation-for="LeadId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" maxlength="150" /><span asp-validation-for="Subject" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ScheduledDate" class="form-label"></label><input asp-for="ScheduledDate" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" /><span asp-validation-for="ScheduledDate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<FollowUpStatus>()" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save Changes</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
