@model ACXIOMCRM.Models.ViewModels.FollowUpListViewModel
@using ACXIOMCRM.Models
@{ ViewData["Title"] = "Pending Follow-ups"; var canCreate = await CrmPermissions.HasPermissionAsync(User, "FollowUps", "Create"); var canEdit = await CrmPermissions.HasPermissionAsync(User, "FollowUps", "Edit"); var canDelete = await CrmPermissions.HasPermissionAsync(User, "FollowUps", "Delete"); }

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div><h2 class="fw-bold mb-1">Pending Follow-ups</h2><p class="text-muted mb-0">Review upcoming activities and follow-ups that are overdue.</p></div>
        @if (canCreate) { <a asp-action="Create" class="btn btn-primary">+ Add Follow-up</a> }
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <form asp-action="Index" method="get" class="card card-body shadow-sm border-0 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-7"><label for="search" class="form-label">Search follow-ups</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Lead name, subject, or description" /></div>
            <div class="col-12 col-sm-7 col-md-3"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in Model.StatusOptions) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div>
            <div class="col-12 col-sm-5 col-md-2 d-flex gap-2"><button type="submit" class="btn btn-primary flex-grow-1">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
        </div>
    </form>

    <div class="card shadow-sm border-0"><div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Lead</th><th>Subject</th><th>Scheduled</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <tr class="table-light"><th colspan="5">Upcoming Planned <span class="badge bg-primary">@Model.UpcomingPlanned.Count</span></th></tr>
                @foreach (var item in Model.UpcomingPlanned)
                {
                    <tr>
                        <td>@item.Lead?.Name</td><td>@item.Subject</td><td>@item.ScheduledDate.ToString("dd MMM yyyy, h:mm tt")</td><td><span class="badge bg-primary">@item.Status</span></td>
                        <td><div class="d-flex flex-wrap gap-1">
                            @if (canEdit) { <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Completed" /><button type="submit" class="btn btn-sm btn-success">Complete</button></form>
                            <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Missed" /><button type="submit" class="btn btn-sm btn-outline-danger">Mark Missed</button></form>
                            <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Cancelled" /><button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button></form> }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>@if (canEdit) { <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> }@if (canDelete) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a> }
                        </div></td>
                    </tr>
                }
                @if (Model.UpcomingPlanned.Count == 0) { <tr><td colspan="5" class="text-muted">No upcoming planned follow-ups match these filters.</td></tr> }

                <tr class="table-danger"><th colspan="5">Overdue Planned <span class="badge bg-danger">@Model.OverduePlanned.Count</span></th></tr>
                @foreach (var item in Model.OverduePlanned)
                {
                    <tr class="table-danger">
                        <td>@item.Lead?.Name</td><td>@item.Subject</td><td>@item.ScheduledDate.ToString("dd MMM yyyy, h:mm tt")</td><td><span class="badge bg-danger">Overdue</span> <span class="badge bg-light text-dark">@item.Status</span></td>
                        <td><div class="d-flex flex-wrap gap-1">
                            @if (canEdit) { <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Completed" /><button type="submit" class="btn btn-sm btn-success">Complete</button></form>
                            <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Missed" /><button type="submit" class="btn btn-sm btn-outline-danger">Mark Missed</button></form>
                            <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@FollowUpStatus.Cancelled" /><button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button></form> }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>@if (canEdit) { <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> }@if (canDelete) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a> }
                        </div></td>
                    </tr>
                }
                @if (Model.OverduePlanned.Count == 0) { <tr><td colspan="5" class="text-muted">No overdue planned follow-ups match these filters.</td></tr> }

                <tr class="table-light"><th colspan="5">Other Follow-ups <span class="badge bg-secondary">@Model.OtherFollowUps.Count</span></th></tr>
                @foreach (var item in Model.OtherFollowUps)
                {
                    var statusClass = item.Status switch { FollowUpStatus.Completed => "bg-success", FollowUpStatus.Missed => "bg-danger", FollowUpStatus.Cancelled => "bg-secondary", _ => "bg-primary" };
                    <tr><td>@item.Lead?.Name</td><td>@item.Subject</td><td>@item.ScheduledDate.ToString("dd MMM yyyy, h:mm tt")</td><td><span class="badge @statusClass">@item.Status</span></td><td><div class="d-flex flex-wrap gap-1"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>@if (canEdit) { <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> }@if (canDelete) { <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a> }</div></td></tr>
                }
                @if (Model.OtherFollowUps.Count == 0) { <tr><td colspan="5" class="text-muted">No completed, missed, or cancelled follow-ups match these filters.</td></tr> }
            </tbody>
        </table>
    </div></div>
</div>
