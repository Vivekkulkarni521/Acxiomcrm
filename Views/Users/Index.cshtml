@model IEnumerable<ACXIOMCRM.Models.ViewModels.UserListItemViewModel>
@{ ViewData["Title"] = "User Management"; }
<div class="container-fluid py-4"><div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4"><div><h2 class="fw-bold mb-1">User Management</h2><p class="text-muted mb-0">Add users, assign roles and teams, and manage account access.</p></div><div class="d-flex gap-2"><a asp-action="Create" class="btn btn-primary">+ Add User</a><a asp-controller="Teams" asp-action="Index" class="btn btn-outline-primary">Manage Teams</a></div></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card shadow-sm border-0"><div class="card-body table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-dark"><tr><th>Name</th><th>Email</th><th>Role</th><th>Team</th><th>Account</th><th>Actions</th></tr></thead><tbody>
@foreach (var user in Model) { <tr><td>@user.DisplayName</td><td>@user.Email</td><td><span class="badge bg-primary">@user.Role</span></td><td>@(user.TeamName ?? "—")</td><td><span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Manage</a>@if (user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) { <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger ms-1">Delete</a> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No registered users.</td></tr> }
</tbody></table></div></div></div>

