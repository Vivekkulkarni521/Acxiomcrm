@model ACXIOMCRM.Models.CrmActivity
@{ ViewData["Title"] = "Delete Activity"; }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 700px"><div class="card-header bg-danger text-white"><h2 class="h4 mb-0">Delete Activity</h2></div><div class="card-body">
<p>Are you sure you want to delete this activity?</p><dl class="row"><dt class="col-sm-4">Subject</dt><dd class="col-sm-8">@Model.Subject</dd><dt class="col-sm-4">Type</dt><dd class="col-sm-8">@Model.Type</dd><dt class="col-sm-4">Scheduled</dt><dd class="col-sm-8">@Model.ScheduledAt.ToString("f")</dd></dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Confirm Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
</div></div></div>
