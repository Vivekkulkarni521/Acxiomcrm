@model ACXIOMCRM.Models.Opportunity
@using ACXIOMCRM.Models
@{ ViewData["Title"] = "Add Opportunity"; }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 760px"><div class="card-header bg-primary text-white"><h4 class="mb-0">Add Opportunity</h4></div><div class="card-body">
@if (!((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Leads).Any()) { <div class="alert alert-warning">Add a lead before creating an opportunity.</div> }
<form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select"><option value="">Select a lead</option></select><span asp-validation-for="LeadId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="200" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Amount" class="form-label"></label><div class="input-group"><span class="input-group-text">$</span><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" /></div><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" class="form-select"></select><span asp-validation-for="Stage" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Probability" class="form-label"></label><div class="input-group"><input asp-for="Probability" type="number" min="0" max="100" step="1" class="form-control" /><span class="input-group-text">%</span></div><span asp-validation-for="Probability" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Save Opportunity</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
