@model ACXIOMCRM.Models.Opportunity
@{ ViewData["Title"] = "Delete Opportunity"; }
<div class="container py-4"><div class="card shadow-sm border-0 mx-auto" style="max-width: 700px"><div class="card-header bg-danger text-white"><h3 class="mb-0">Delete Opportunity</h3></div><div class="card-body"><h5>Are you sure you want to delete this opportunity?</h5><dl class="row mt-3"><dt class="col-sm-4">Lead</dt><dd class="col-sm-8">@Model.Lead?.Name</dd><dt class="col-sm-4">Title</dt><dd class="col-sm-8">@Model.Title</dd><dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@Model.Amount.ToString("N2")</dd><dt class="col-sm-4">Stage</dt><dd class="col-sm-8">@Model.Stage</dd><dt class="col-sm-4">Expected close</dt><dd class="col-sm-8">@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd></dl><form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Confirm Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form></div></div></div>
