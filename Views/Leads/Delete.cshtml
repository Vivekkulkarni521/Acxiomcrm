@model ACXIOMCRM.Models.Lead

@{
    ViewData["Title"] = "Delete Lead";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h3>Delete Lead</h3>
        </div>
        <div class="card-body">
            <h5>Are you sure you want to delete this lead?</h5>

            <p><strong>Name:</strong> @Model.Name</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Company:</strong> @Model.Company</p>

            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
