@model IEnumerable<ACXIOMCRM.Models.Team>
@{ ViewData["Title"] = "Team Management"; var createModel = ViewBag.CreateTeam as ACXIOMCRM.Models.ViewModels.CreateTeamViewModel ?? new ACXIOMCRM.Models.ViewModels.CreateTeamViewModel(); }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold mb-1">Team Management</h2><p class="text-muted mb-0">Managers can access records assigned to members of their team.</p></div><a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Back to Users</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div class="row g-4"><div class="col-lg-5"><div class="card shadow-sm border-0"><div class="card-header"><h3 class="h5 mb-0">Create team</h3></div><div class="card-body"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label for="Name" class="form-label">Team name</label><input name="Name" id="Name" value="@createModel.Name" class="form-control" maxlength="100" required /><span class="text-danger">@Html.ValidationMessage("Name")</span></div><button class="btn btn-primary" type="submit">Create Team</button></form></div></div></div>
<div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Team</th><th>Members</th></tr></thead><tbody>@foreach (var team in Model) { <tr><td>@team.Name</td><td>@team.Members.Count</td></tr> }@if (!Model.Any()) { <tr><td colspan="2" class="text-center text-muted py-4">No teams created yet.</td></tr> }</tbody></table></div></div></div></div></div>
