@model ACXIOMCRM.Models.ViewModels.ManualAuditListViewModel
@{ ViewData["Title"] = "Audit Management"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
        <div><h2>Audit Management</h2><p class="text-muted mb-0">Create and manage audit reviews, findings and status.</p></div>
        <div class="d-flex gap-2"><a asp-action="Report" class="btn btn-outline-primary">Generate Manual Report</a><a asp-action="Create" class="btn btn-primary">Create Audit</a></div>
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    <form asp-action="Index" method="get" class="card card-body shadow-sm border-0 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-3"><label class="form-label" for="search">Search</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Title, auditor or findings" /></div>
            <div class="col-6 col-lg-2"><label class="form-label" for="department">Department</label><select id="department" name="department" class="form-select"><option value="">All departments</option>@foreach (var item in Model.Departments) { <option value="@item" selected="@(item == Model.Department)">@item</option> }</select></div>
            <div class="col-6 col-lg-2"><label class="form-label" for="auditorUserId">Auditor</label><select id="auditorUserId" name="auditorUserId" class="form-select"><option value="">All auditors</option>@foreach (var item in Model.Auditors) { <option value="@item.Value" selected="@(item.Value == Model.AuditorUserId)">@item.Text</option> }</select></div>
            <div class="col-6 col-lg-2"><label class="form-label" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in Enum.GetValues<ACXIOMCRM.Models.ManualAuditStatus>()) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div>
            <div class="col-6 col-lg-1"><label class="form-label" for="dateFrom">From</label><input id="dateFrom" type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-6 col-lg-1"><label class="form-label" for="dateTo">To</label><input id="dateTo" type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-12 col-lg-1 d-flex gap-2"><button class="btn btn-primary" type="submit">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
        </div>
    </form>
    <div class="card shadow-sm border-0"><div class="card-body table-responsive">
        <table class="table table-striped table-hover align-middle mb-0"><thead class="table-dark"><tr><th>Title</th><th>Department</th><th>Auditor</th><th>Audit date</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
        @if (Model.Audits.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No audit records match these filters.</td></tr> }
        else { @foreach (var audit in Model.Audits) { <tr><td>@audit.Title</td><td>@audit.Department</td><td>@audit.AuditorName</td><td class="text-nowrap">@audit.AuditDate.ToString("yyyy-MM-dd")</td><td><span class="badge @(audit.Status == ACXIOMCRM.Models.ManualAuditStatus.Completed ? "bg-success" : audit.Status == ACXIOMCRM.Models.ManualAuditStatus.InProgress ? "bg-primary" : "bg-secondary")">@audit.Status</span></td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@audit.Id" class="btn btn-sm btn-outline-info">View</a> <a asp-action="Edit" asp-route-id="@audit.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@audit.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> } }
        </tbody></table>
    </div></div>
</div>

