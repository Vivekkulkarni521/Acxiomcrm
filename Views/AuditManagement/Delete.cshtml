@model ACXIOMCRM.Models.ManualAudit
@{ ViewData["Title"] = "Delete Audit"; }
<div class="container py-4"><div class="card border-danger shadow-sm"><div class="card-header bg-danger text-white"><h2 class="h4 mb-0">Confirm Audit Deletion</h2></div><div class="card-body"><p>Delete the audit record <strong>@Model.Title</strong>? Its historical create, update and delete report entries will be retained.</p><dl class="row"><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd><dt class="col-sm-3">Auditor</dt><dd class="col-sm-9">@Model.AuditorName</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Findings</dt><dd class="col-sm-9">@Model.Findings</dd></dl><form asp-action="Delete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Delete Audit</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div></div>
