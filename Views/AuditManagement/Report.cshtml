@model ACXIOMCRM.Models.ViewModels.ManualAuditReportViewModel
@{ ViewData["Title"] = "Audit Reports"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3"><div><h2>Audit Reports</h2><p class="text-muted mb-0">Created, updated and deleted manual audit records, including stored findings and auditor snapshots.</p></div><div class="d-flex gap-2"><a asp-action="ExportCsv" asp-route-search="@Model.Search" asp-route-userName="@Model.UserName" asp-route-auditorName="@Model.AuditorName" asp-route-eventAction="@Model.Action" asp-route-status="@Model.Status" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-outline-success">Export CSV</a><a asp-action="ExportPdf" asp-route-search="@Model.Search" asp-route-userName="@Model.UserName" asp-route-auditorName="@Model.AuditorName" asp-route-eventAction="@Model.Action" asp-route-status="@Model.Status" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-outline-danger">Export PDF</a></div></div>
    <form asp-action="Report" method="get" class="card card-body shadow-sm border-0 mb-4"><div class="row g-3 align-items-end">
        <div class="col-12 col-lg-3"><label for="search" class="form-label">Search</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Title, findings or department" /></div>
        <div class="col-6 col-lg-2"><label for="userName" class="form-label">Changed by</label><select id="userName" name="userName" class="form-select"><option value="">All users</option>@foreach (var value in Model.Users) { <option value="@value" selected="@(value == Model.UserName)">@value</option> }</select></div>
        <div class="col-6 col-lg-2"><label for="auditorName" class="form-label">Auditor</label><select id="auditorName" name="auditorName" class="form-select"><option value="">All auditors</option>@foreach (var value in Model.Auditors) { <option value="@value" selected="@(value == Model.AuditorName)">@value</option> }</select></div>
        <div class="col-6 col-lg-1"><label for="eventAction" class="form-label">Action</label><select id="eventAction" name="eventAction" class="form-select"><option value="">All</option>@foreach (var value in Model.Actions) { <option value="@value" selected="@(value == Model.Action)">@value</option> }</select></div>
        <div class="col-6 col-lg-1"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All</option>@foreach (var value in Model.Statuses) { <option value="@value" selected="@(value == Model.Status)">@value</option> }</select></div>
        <div class="col-6 col-lg-1"><label for="dateFrom" class="form-label">From</label><input id="dateFrom" type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-6 col-lg-1"><label for="dateTo" class="form-label">To</label><input id="dateTo" type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-12 col-lg-1 d-flex gap-2"><button class="btn btn-primary" type="submit">Filter</button><a asp-action="Report" class="btn btn-outline-secondary">Clear</a></div>
    </div></form>
    @if (Model.Total == 0) { <div class="alert alert-info">No manual audit changes match these filters. The report contains only saved audit records.</div> }
    else {
        <div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Total events</div><div class="fs-3 fw-semibold">@Model.Total.ToString("N0")</div></div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Created</div><div class="fs-3 fw-semibold">@Model.Created.ToString("N0")</div></div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Updated</div><div class="fs-3 fw-semibold">@Model.Updated.ToString("N0")</div></div></div></div><div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Deleted</div><div class="fs-3 fw-semibold">@Model.Deleted.ToString("N0")</div></div></div></div></div>
        <div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">Audit change history</h5></div><div class="card-body table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead class="table-dark"><tr><th>Changed (UTC)</th><th>Action</th><th>Changed by</th><th>Audit ID</th><th>Title</th><th>Department</th><th>Auditor</th><th>Audit date</th><th>Status</th><th>Description</th><th>Findings</th></tr></thead><tbody>@foreach (var item in Model.Events) { <tr><td class="text-nowrap">@DateTime.SpecifyKind(item.Timestamp, DateTimeKind.Utc).ToString("yyyy-MM-dd HH:mm:ss")</td><td><span class="badge @(item.Action == "Delete" ? "bg-danger" : item.Action == "Create" ? "bg-success" : "bg-primary")">@item.Action</span></td><td>@item.UserName</td><td>@item.AuditRecordId</td><td>@item.Title</td><td>@item.Department</td><td>@item.AuditorName</td><td class="text-nowrap">@item.AuditDate.ToString("yyyy-MM-dd")</td><td>@item.Status</td><td class="text-break">@item.Description</td><td class="text-break">@item.Findings</td></tr> }</tbody></table></div></div>
    }
</div>



