@model ACXIOMCRM.Models.ManualAudit
@{ ViewData["Title"] = "Audit Details"; }
<div class="container py-4"><div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between"><h2 class="h4 mb-0">@Model.Title</h2><span class="badge bg-secondary">@Model.Status</span></div><div class="card-body"><dl class="row"><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd><dt class="col-sm-3">Auditor</dt><dd class="col-sm-9">@Model.AuditorName</dd><dt class="col-sm-3">Audit date</dt><dd class="col-sm-9">@Model.AuditDate.ToString("yyyy-MM-dd")</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9 text-break">@Model.Description</dd><dt class="col-sm-3">Findings</dt><dd class="col-sm-9 text-break">@Model.Findings</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc).ToString("u") UTC</dd><dt class="col-sm-3">Last updated</dt><dd class="col-sm-9">@DateTime.SpecifyKind(Model.UpdatedAt, DateTimeKind.Utc).ToString("u") UTC</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div></div>
