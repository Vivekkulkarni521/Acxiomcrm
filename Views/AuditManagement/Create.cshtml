@model ACXIOMCRM.Models.ViewModels.ManualAuditFormViewModel
@{ ViewData["Title"] = "Create Audit"; }
<div class="container py-4"><div class="card shadow-sm border-0"><div class="card-header bg-white"><h2 class="h4 mb-0">Create Audit</h2></div><div class="card-body"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<partial name="_Form" model="Model" /><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Save Audit</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
